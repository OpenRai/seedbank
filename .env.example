# seedbank environment. Copy to .env and adjust as needed.
PORT=8787
HOST=0.0.0.0

# SQLite cache for public account state
CACHE_DB=./data/cache.sqlite
CACHE_TTL_MS=3600000

# Request limits
ADDRESS_LIMIT=100
RATE_LIMIT_PER_MINUTE=120

# Upstream Nano RPC nodes, comma separated, tried in order
RPC_TIMEOUT_MS=10000
# RPC_NODES=https://rainstorm.city/api,https://nanoslo.0x.no/proxy,https://rpc.nano.to

# Frontend build settings (public, embedded by Vite).
# Options: proxy, nano-rpc, json-rpc. Local builds default to proxy.
VITE_LOOKUPS=proxy
# Optional comma-separated browser-accessible Nano RPC URLs; omit for defaults.
# VITE_NANO_RPC_URLS=https://rainstorm.city/api,https://rpc.nano.to
# Required when using lookups=json-rpc; include the /rpc endpoint path.
# VITE_JSON_RPC_URL=https://your-gateway.example/rpc
